{
  "name": "bolsaram",
  "version": "0.0.0",
  "private": true,
  "description": "볼사람(Bolsaram): 주선자가 검증한 사람만 참여하는 비공개 소개팅 서비스",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @bolsaram/db migrate",
    "db:reset": "pnpm --filter @bolsaram/db reset",
    "db:seed": "pnpm --filter @bolsaram/db seed",
    "dev": "pnpm --filter @bolsaram/web dev",
    "build": "pnpm --filter @bolsaram/web build",
    "start": "pnpm --filter @bolsaram/web start",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "pnpm -r --no-bail lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:cleanup": "pnpm --filter @bolsaram/db cleanup",
    "db:backup": "bash scripts/db-backup.sh",
    "db:purge-seed": "tsx scripts/purge-seed.ts",
    "db:backup:list": "bash scripts/db-backup.sh --list",
    "db:backup:verify": "bash scripts/db-backup.sh --verify",
    "pm2:start": "pm2 start ecosystem.config.cjs && pm2 save",
    "pm2:restart": "pm2 restart bolsaram-web",
    "pm2:stop": "pm2 stop bolsaram-web",
    "pm2:status": "pm2 status bolsaram-web bolsaram-cleanup",
    "pm2:logs": "pm2 logs bolsaram-web --lines 50",
    "pm2:save": "pm2 save",
    "deploy:web": "pnpm build && pm2 restart bolsaram-web",
    "agents:sync": "python3 .agent-config/sync.py",
    "agents:check": "python3 .agent-config/sync.py --check",
    "agents:test": "python3 .agent-config/guard-cases.py",
    "telegram:webhook": "tsx scripts/telegram-webhook.ts",
    "ai:check": "tsx scripts/ai-check.ts"
  },
  "devDependencies": {
    "@bolsaram/db": "workspace:^",
    "@bolsaram/domain": "workspace:^",
    "@bolsaram/schemas": "workspace:^",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/node": "^22.20.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "server-only": "^0.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "license": "UNLICENSED"
}
