{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm verify)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:logs)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:cleanup)",
      "Bash(pnpm --filter :*)",
      "Bash(npx vitest run :*)",
      "Bash(npx tsc :*)",
      "Bash(pm2 status :*)",
      "Bash(pm2 jlist)",
      "Bash(pm2 logs :*)",
      "Bash(pm2 restart bolsaram-:*)",
      "Bash(pm2 start ecosystem.config.cjs :*)",
      "Bash(pm2 describe bolsaram-:*)",
      "Bash(docker ps :*)",
      "Bash(docker compose ps :*)",
      "Bash(docker exec bolsaram_postgres :*)",
      "Bash(curl -s http://127.0.0.1:3020/* :*)",
      "Bash(curl -s -o /dev/null -w :*)",
      "Bash(ss -ltn :*)",
      "Bash(grep :*)",
      "Bash(rg :*)",
      "Bash(git status :*)",
      "Bash(git diff :*)",
      "Bash(git log :*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./var/storage/**)",
      "Read(./var/log/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent-config/sync.py\" --quiet"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-sensitive.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/track-changes.sh"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agent-config/sync.py\" --quiet"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/mark-turn-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-on-stop.sh"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false
}
