# ── 데이터베이스 ───────────────────────────────────────────────
# 마이그레이션/시드용 소유자 커넥션 (docker-compose.yml 값과 일치)
DATABASE_URL=postgres://bolsaram_owner:bolsaram0711@127.0.0.1:5442/bolsaram
# 런타임 앱 커넥션. RLS 가 적용되는 NOBYPASSRLS 롤을 쓴다.
# 비밀번호는 db/migrations/0001_roles.sql 이 아니라 아래 값을 기준으로 설정된다.
APP_DATABASE_URL=postgres://bolsaram_app:bolsaram_app0711@127.0.0.1:5442/bolsaram

# ── 서버 ──────────────────────────────────────────────────────
# local | staging | production
# production 으로 두면 개발 편의 기능(OTP 화면 노출)이 잠긴다.
APP_ENV=local
PORT=3020
APP_ORIGIN=http://127.0.0.1:3020

# ── 시크릿 (openssl rand -hex 32 로 생성) ─────────────────────
# 세션 쿠키 서명 키
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# 스토리지 signed URL 서명 키
STORAGE_SECRET=change-me-storage-secret-at-least-32-chars
# 초대 토큰 해시 pepper
INVITE_TOKEN_PEPPER=change-me-invite-pepper-at-least-32-chars

# ── 로컬 private 스토리지 ─────────────────────────────────────
# 절대경로를 쓴다. 웹 서버(cwd=apps/web)와 CLI(cwd=리포 루트)가 같은 곳을 봐야 한다.
STORAGE_ROOT=/absolute/path/to/bolsaram/var/storage
# signed URL 유효시간(초)
STORAGE_SIGNED_URL_TTL=300

# ── AI 추출 프로바이더 ────────────────────────────────────────
# mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
# GPT-5.6 계열은 temperature 를 받지 않는다(기본값 1만 허용). 코드에서 보내지 않는다.
OPENAI_MODEL=gpt-5.6-luna

# ── 개발 편의 ─────────────────────────────────────────────────
# true 면 회원 로그인 OTP 를 서버 콘솔에 출력하고 API 응답에 포함한다(운영 금지).
DEV_EXPOSE_OTP=true
