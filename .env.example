# ── 데이터베이스 ───────────────────────────────────────────────
# 마이그레이션/시드용 소유자 커넥션 (docker-compose.yml 값과 일치)
DATABASE_URL=postgres://bolsaram_owner:bolsaram0711@127.0.0.1:5442/bolsaram
# 런타임 앱 커넥션. RLS 가 적용되는 NOBYPASSRLS 롤을 쓴다.
# 비밀번호는 db/migrations/0001_roles.sql 이 아니라 아래 값을 기준으로 설정된다.
APP_DATABASE_URL=postgres://bolsaram_app:bolsaram_app0711@127.0.0.1:5442/bolsaram

# ── 서버 ──────────────────────────────────────────────────────
# local | staging | production
# production 으로 두면 APP_ORIGIN 이 https 여야 하고 아래 기본 시크릿을 쓸 수 없다.
# (둘 다 기동 시 검증한다 — 걸리면 프로세스는 살아 있고 모든 요청이 500 이 된다)
APP_ENV=local
PORT=3020
APP_ORIGIN=http://127.0.0.1:3020

# ── 시크릿 (openssl rand -hex 32 로 생성) ─────────────────────
# 세션 쿠키 서명 키
SESSION_SECRET=change-me-session-secret-at-least-32-chars
# 스토리지 signed URL 서명 키
STORAGE_SECRET=change-me-storage-secret-at-least-32-chars
# 초대 토큰 해시 pepper
INVITE_TOKEN_PEPPER=change-me-invite-pepper-at-least-32-chars

# ── 로컬 private 스토리지 ─────────────────────────────────────
# 절대경로를 쓴다. 웹 서버(cwd=apps/web)와 CLI(cwd=리포 루트)가 같은 곳을 봐야 한다.
STORAGE_ROOT=/absolute/path/to/bolsaram/var/storage
# signed URL 유효시간(초)
STORAGE_SIGNED_URL_TTL=300

# ── DB 백업 ───────────────────────────────────────────────────
# 백업은 var/backup 에 쌓인다(같은 디스크). 다른 디스크·마운트에 사본을 두려면
# 절대경로를 준다. 비워두면 사본을 만들지 않고, 경로를 못 쓰면 경고만 하고 넘어간다.
# 덤프에는 실명·연락처가 들어 있으니 남이 읽을 수 없는 곳을 쓴다.
BACKUP_MIRROR_DIR=

# ── AI 추출 프로바이더 ────────────────────────────────────────
# mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
# GPT-5.6 계열은 temperature 를 받지 않는다(기본값 1만 허용). 코드에서 보내지 않는다.
OPENAI_MODEL=gpt-5.6-luna

# ── 텔레그램 Import 채널 ──────────────────────────────────────
# 끄면 webhook 이 404 를 주고 관리자 화면에서도 연결할 수 없다.
# 켤 때는 아래 두 값이 반드시 필요하다(없으면 서버가 기동을 거부한다).
TELEGRAM_ENABLED=false
# @BotFather 가 발급한 토큰
TELEGRAM_BOT_TOKEN=
# setWebhook 의 secret_token. 텔레그램이 이 값을 요청 헤더로 되돌려주고 우리가 확인한다.
# Bot API 가 허용하는 문자는 A-Z a-z 0-9 _ - 뿐이므로 `openssl rand -hex 32` 를 쓴다.
TELEGRAM_WEBHOOK_SECRET=
