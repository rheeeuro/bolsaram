{
  "version": 1,
  "hooks": {
    "sync_on_session_start": true,
    "sync_after_edit": true,
    "guard_sensitive": true,
    "quality_after_edit": true,
    "deploy_on_stop": true
  },
  "claude_settings": {
    "includeCoAuthoredBy": false
  },
  "claude_permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm verify)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm db:up)",
      "Bash(pnpm db:logs)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:cleanup)",
      "Bash(pnpm --filter :*)",
      "Bash(npx vitest run :*)",
      "Bash(npx tsc :*)",
      "Bash(pm2 status :*)",
      "Bash(pm2 jlist)",
      "Bash(pm2 logs :*)",
      "Bash(pm2 restart bolsaram-:*)",
      "Bash(pm2 start ecosystem.config.cjs :*)",
      "Bash(pm2 describe bolsaram-:*)",
      "Bash(docker ps :*)",
      "Bash(docker compose ps :*)",
      "Bash(docker exec bolsaram_postgres :*)",
      "Bash(curl -s http://127.0.0.1:3020/* :*)",
      "Bash(curl -s -o /dev/null -w :*)",
      "Bash(ss -ltn :*)",
      "Bash(grep :*)",
      "Bash(rg :*)",
      "Bash(git status :*)",
      "Bash(git diff :*)",
      "Bash(git log :*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./var/storage/**)",
      "Read(./var/log/**)"
    ]
  },
  "codex_rules": [
    {
      "pattern": ["pnpm", "verify"],
      "decision": "allow",
      "justification": "타입체크·린트·테스트 통합 검증"
    },
    {
      "pattern": ["pnpm", "typecheck"],
      "decision": "allow",
      "justification": "TypeScript 정적 검사"
    },
    {
      "pattern": ["pnpm", "lint"],
      "decision": "allow",
      "justification": "ESLint 검사"
    },
    {
      "pattern": ["pnpm", "test"],
      "decision": "allow",
      "justification": "vitest 실행"
    },
    {
      "pattern": ["pnpm", "build"],
      "decision": "allow",
      "justification": "Next.js 빌드"
    },
    {
      "pattern": ["pnpm", "db:migrate"],
      "decision": "allow",
      "justification": "로컬 DB 마이그레이션 적용"
    },
    {
      "pattern": ["pnpm", "db:seed"],
      "decision": "allow",
      "justification": "합성 시드 데이터 적재"
    },
    {
      "pattern": ["pm2", "status"],
      "decision": "allow",
      "justification": "PM2 상태 확인"
    },
    {
      "pattern": ["pm2", "jlist"],
      "decision": "allow",
      "justification": "PM2 상태 JSON 확인"
    },
    {
      "pattern": ["pm2", "logs"],
      "decision": "allow",
      "justification": "PM2 로그 확인"
    },
    {
      "pattern": ["docker", "ps"],
      "decision": "allow",
      "justification": "로컬 컨테이너 상태 확인"
    },
    {
      "pattern": ["rg"],
      "decision": "allow",
      "justification": "저장소 텍스트 검색"
    }
  ]
}
